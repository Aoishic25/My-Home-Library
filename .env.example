# Copy this file to .env and fill in real values.
# .env is gitignored — this file (.env.example) is the one that gets committed.

# --- Used by the Node app (app.js) ---
DATABASE_HOST=db
DATABASE_USER=root
DATABASE_PASSWORD=changeme
DATABASE=Shelf

# docker-compose reuses DATABASE_PASSWORD above as the MySQL root password
# (DATABASE_USER is assumed to be root for the Docker setup).
