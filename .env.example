# Copy this file to .env and fill in real values.
# .env is gitignored — this file (.env.example) is the one that gets committed.

# --- Used by the Node app (app.js) ---
DATABASE_HOST=db
DATABASE_USER=root
DATABASE_PASSWORD=changeme
DATABASE=Shelf

# docker-compose reuses DATABASE_PASSWORD above as the MySQL root password
# (DATABASE_USER is assumed to be root for the Docker setup).

# --- Login for the write routes (add / edit / delete) ---
# Read-only pages stay public. Without ADMIN_PASSWORD, login is disabled and
# every write route stays locked. Pick your own strong password.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Signs the login cookie. Any long random string; if omitted, a random one is
# generated at startup (you are then logged out whenever the app restarts).
SESSION_SECRET=
