<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search</title>
    <link rel="stylesheet" href="/style5.css">
</head>
<body>
    <nav>
        <a href="/">Back</a>
    </nav>
    <h1>Search Everything</h1>
    <form id="search-form" method="get" action="/search">
        <label for="q">Title, author, name or meaning:</label>
        <input type="search" id="q" name="q" value="{{q}}" placeholder="e.g. egypt" autofocus required minlength="2">
        <button type="submit">Search</button>
    </form>

    {{#if tooShort}}<p class="hint">Type at least 2 characters.</p>{{/if}}
    {{#if q}}{{#unless tooShort}}
    <p class="hint">{{totalHits}} match(es) shown across {{groups.length}} table(s) for "{{q}}"</p>
    {{/unless}}{{/if}}

    {{#each groups}}
    <h2>{{this.db}} &rsaquo; {{this.table}}</h2>
    <div class="results">
        <table>
            <thead><tr>{{#each this.columns}}<th>{{this}}</th>{{/each}}</tr></thead>
            <tbody>
                {{#each this.rows}}
                <tr>{{#each this}}<td>{{#if this}}{{this}}{{else}}<span class="null">&mdash;</span>{{/if}}</td>{{/each}}</tr>
                {{/each}}
            </tbody>
        </table>
    </div>
    <a class="more-link" href="{{this.link}}">{{#if this.more}}See all matches{{else}}Open in table view{{/if}} &rarr;</a>
    {{else}}
    {{#if q}}{{#unless tooShort}}<p class="hint">Nothing found.</p>{{/unless}}{{/if}}
    {{/each}}
</body>
</html>
