<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Watchlist</title>
    <link rel="stylesheet" href="/style7.css">
</head>
<body>
    <header>
        <a href="/" class="back-btn">Back</a>
        <h1>Watchlist</h1>
    </header>
    <div class="tabs">
        <button class="tab-btn {{#if showsActive}}active{{/if}}" onclick="switchTab('cartoons',this)">Cartoons</button>
        <button class="tab-btn {{#if moviesActive}}active{{/if}}" onclick="switchTab('movies',this)">Movies</button>
    </div>

    <div id="tab-cartoons" class="tab-content {{#if showsActive}}active{{/if}}">
        <div class="table-wrap">
            {{#if shows.length}}
            <table>
                <thead>
                    <tr>
                        {{#each shows.[0]}}
                            <th>{{@key}}</th>
                        {{/each}}
                    </tr>
                </thead>
                <tbody>
                    {{#each shows}}
                        <tr>
                            {{#each this}}
                                <td>{{this}}</td>
                            {{/each}}
                        </tr>
                    {{/each}}
                </tbody>
            </table>
            {{else}}
            <p class="empty">No shows in the watchlist yet</p>
            {{/if}}
        </div>
        {{#with showsPager}}
        {{#if paged}}
        <nav class="pager" aria-label="Cartoons pages">
            {{#if hasPrev}}<a href="{{prevUrl}}">&larr; Prev</a>{{else}}<span></span>{{/if}}
            <span>Page {{page}} of {{pages}} &middot; {{total}} total</span>
            {{#if hasNext}}<a href="{{nextUrl}}">Next &rarr;</a>{{else}}<span></span>{{/if}}
        </nav>
        {{/if}}
        {{/with}}
    </div>

    <div id="tab-movies" class="tab-content {{#if moviesActive}}active{{/if}}">
        <div class="table-wrap">
            {{#if movies.length}}
            <table>
                <thead>
                    <tr>
                        {{#each movies.[0]}}
                            <th>{{@key}}</th>
                        {{/each}}
                    </tr>
                </thead>
                <tbody>
                    {{#each movies}}
                        <tr>
                            {{#each this}}
                                <td>{{this}}</td>
                            {{/each}}
                        </tr>
                    {{/each}}
                </tbody>
            </table>
            {{else}}
            <p class="empty">No movies in the watchlist yet</p>
            {{/if}}
        </div>
        {{#with moviesPager}}
        {{#if paged}}
        <nav class="pager" aria-label="Movies pages">
            {{#if hasPrev}}<a href="{{prevUrl}}">&larr; Prev</a>{{else}}<span></span>{{/if}}
            <span>Page {{page}} of {{pages}} &middot; {{total}} total</span>
            {{#if hasNext}}<a href="{{nextUrl}}">Next &rarr;</a>{{else}}<span></span>{{/if}}
        </nav>
        {{/if}}
        {{/with}}
    </div>

    <script>
        function switchTab(name,btn){
            document.querySelectorAll('.tab-content').forEach(t=>t.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
            document.getElementById('tab-'+name).classList.add('active');
            btn.classList.add('active');
        }
    </script>
</body>
</html>